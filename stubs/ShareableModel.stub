<?php

namespace App\Models;

use Illuminate\Database\Eloquent\Model;
use Illuminate\Support\Str;
use Siberfx\SocialAutopost\Concerns\PostsToSocial;
use Siberfx\SocialAutopost\Contracts\ShareableOnSocial;
use Siberfx\SocialAutopost\Posts\LinkPost;

/**
 * Example: a model that is posted to social networks when it goes live.
 *
 * 1. implement ShareableOnSocial and use PostsToSocial;
 * 2. say when it is live (isLiveForSocial);
 * 3. say what to post (toSocialPost).
 */
class Article extends Model implements ShareableOnSocial
{
    use PostsToSocial;

    public function isLiveForSocial(): bool
    {
        return $this->status === 'published';
    }

    public function toSocialPost(): LinkPost
    {
        $post = LinkPost::make(url: route('articles.show', $this), title: $this->title)
            ->description(Str::limit(strip_tags((string) $this->excerpt), 250))
            ->commentary("{title}\n\n{url}");

        // Instagram and TikTok post media, not links: give them a public image or video.
        return $this->cover_url !== null ? $post->image($this->cover_url) : $post;
    }
}
